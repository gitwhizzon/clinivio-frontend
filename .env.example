# ─── Backend API URL ──────────────────────────────────────────────────────────
# Single unified Clinivio API service (all routes on one endpoint).
# Development: http://localhost:3000
# Production:  https://clinivio-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Multi-tenant subdomains ───────────────────────────────────────────────────
# Must match the backend's PLATFORM_DOMAINS.
#   app.megnim.com     → platform / super admin
#   hansvl.megnim.com  → tenant "hansvl", auto-detected on the login page
NEXT_PUBLIC_PLATFORM_DOMAINS=megnim.com
